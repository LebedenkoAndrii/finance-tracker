<% if @friends %>
  <h2>Search result:</h2>
  <div class="card card-header d-flex flex-column">
    <table class="table table-striped table-hover table-bordered">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Profile</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @friends.each do |friend| %>
          <tr>
            <th scope="row"><%= friend.fullname %></th>
            <td><%= friend.email %></td>
            <td class="text-center"><strong><%= link_to "View profile", "#", class: "btn btn-sm btn-success" %></strong></td>
            <td class="text-center"><%= link_to "Follow friend?", "#", class: "btn btn-sm btn-success", turbo_method: :post %></td>
          </tr>
          <% end %>
        </tbody>
      </table>
  </div>
<% end %> 