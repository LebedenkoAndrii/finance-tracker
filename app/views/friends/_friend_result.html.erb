<% if @friends.any? %>
  <h2>Search result:</h2>
  <div class="card card-header d-flex flex-column">
    <table class="table table-striped table-hover table-bordered">
        <thead>
          <tr>
            <th scope="col">Name</th>
            <th scope="col">Email</th>
            <th scope="col">Profile</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @friends.each do |friend| %>
          <tr>
            <th scope="row"><%= friend.fullname %></th>
            <td><%= friend.email %></td>
            <td class="text-center"><strong><%= link_to "View profile", "#", class: "btn btn-sm btn-success" %></strong></td>
            <% if current_user.not_friends_with?(friend.id) %>
              <td class="text-center"><%= link_to "Follow friend?", friendships_path(friend: friend), class: "btn btn-sm btn-success", data: {turbo_method: :post}  %></td>
            <% else %>
              <td class="text-center"><span class="badge text-bg-secondary">You are friends</span></td>
            <% end %>
          </tr>
          <% end %>
        </tbody>
      </table>
  </div>
<% end %> 