  <div class="row mt-3">
    <div class="col-9">
      <table class="table table-striped table-hover table-bordered">
        <thead>
          <tr>
            <th scope="col">Email</th>
            <th scope="col">First name</th>
            <th scope="col">Last name</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @friends_list.each do |friend| %>
          <tr>
            <th scope="row"><%= friend.email %></th>
            <td><%= friend.first_name %></td>
            <td><%= friend.last_name %></td>
            <td class="text-center">
            <%= link_to "View profile", user_path(friend) , class: "btn btn-sm btn-success" %>
            <%= link_to "Stop following", friendship_path(friend), data: {turbo_confirm: "Are you sure?", turbo_method: :delete}, class: "btn btn-warning" %>
            </td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>