  <div class="row mt-3">
    <div class="col-9">
      <table class="table table-striped table-hover table-bordered">
        <thead>
          <tr>
            <th scope="col">Email</th>
            <th scope="col">First name</th>
            <th scope="col">Last name</th>
            <th scope="col">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% @friends.each do |friends| %>
          <tr>
            <th scope="row"><%= friends.email %></th>
            <td><%= friends.first_name %></td>
            <td><%= friends.last_name %></td>
            <td><%= link_to "Stop following", "#", data: {turbo_confirm: "Are you sure?", turbo_method: :delete}, class: "btn btn-warning" %></td>
          </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>