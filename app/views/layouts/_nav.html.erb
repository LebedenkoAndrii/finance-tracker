              <li><a class="dropdown-item" href="#">Something else here</a></li>
            </ul>
          </li>
        </ul>
        <ul class="navbar-nav me-2 align-items-center">
          <li class="nav-item username">
            <i class="bi bi-person-circle"></i>
            <span class="pe-2"><%= current_user.fullname %></span>
          </li>
