<h1>Friends</h1>

<div class="w-100 pt-5 d-flex flex-column mb-3">
  <h3>Search friend</h3>
  <%= form_tag search_friend_path, data: { turbo: true }, method: :get do |form| %>
    <div class="form-group row">
      <div class="col-sm-9 pe-0">
        <%= text_field_tag :friend, params[:friend], placeholder: "Name or email", autofocus: true, class: "form-control form-control-lg" %>
      </div>
      <div class="col-sm-3 ps-0">
        <%= button_tag type: :submit, class: "btn btn-success" do %>
          <i class="bi bi-search fs-4"></i>
        <% end %>
      </div>
    </div>
  <% end %>
</div>

<%= render "friends/friend_result" %>

<h2 class="mt-3">List of your friends</h2>
<% if !@friends_list.empty? %>
  <%= render "friends/list" %>
<% end %>