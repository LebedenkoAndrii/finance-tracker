<h2 class="mt-3">User Details</h2>

<div class="card my-4" style="width: 18rem;">
  <div class="card-body">
    <h5 class="card-title"><%= @user.fullname %></h5>
    <p class="card-text"><%= @user.email %></p>
    <% if current_user.not_friends_with?(@user.id) %>
      <td class="text-center"><%= link_to "Follow friend?", friendships_path(friend: @user), class: "btn btn-sm btn-success", data: {turbo_method: :post}  %></td>
    <% else %>
      <td class="text-center"><span class="badge text-bg-secondary">You are friends</span></td>
    <% end %>
  </div>
</div>
<% if !@tracked_stocks.empty? %>
  <%= render "stocks/list" %>
<% else %>
  <p class="lead">This user not tracking any stocks</p>
<% end %>